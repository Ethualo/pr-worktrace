{
  "name": "@pr-worktrace/action",
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm typecheck && ncc build src/main.ts -o dist",
    "test:coverage": "vitest run --coverage --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@pr-worktrace/core": "workspace:*",
    "@pr-worktrace/providers": "workspace:*",
    "@pr-worktrace/github": "workspace:*",
    "@pr-worktrace/worklog": "workspace:*",
    "@actions/core": "^1.10.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.44.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
